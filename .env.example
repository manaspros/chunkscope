# LiteLLM Configuration
LITELLM_API_KEY=your-api-key
LITELLM_BASE_URL=https://your-litellm-proxy.com

# Database
DATABASE_URL=postgresql+asyncpg://chunkscope:chunkscope@postgres:5432/chunkscope

# Optional: Direct API keys (if not using LiteLLM proxy)
OPENAI_API_KEY=
COHERE_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Feature Flags
NEXT_PUBLIC_ENABLE_SHADERS=false
